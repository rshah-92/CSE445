<?xml version="1.0"?>
<configuration>
	<system.serviceModel>
		<services>
			<service name="WeatherService">
				<endpoint address=""
						  binding="webHttpBinding"
						  contract="IWeatherService"
						  behaviorConfiguration="webBehavior"/>
			</service>
		</services>
		<behaviors>
			<endpointBehaviors>
				<behavior name="webBehavior">
					<webHttp/>
				</behavior>
			</endpointBehaviors>
			<serviceBehaviors>
				<behavior>
					<serviceMetadata httpGetEnabled="true"/>
					<serviceDebug includeExceptionDetailInFaults="true"/>
				</behavior>
			</serviceBehaviors>
		</behaviors>
	</system.serviceModel>
</configuration>